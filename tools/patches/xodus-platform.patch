+class XNetworkingObject : public IXNetworkingImpl2
+{
+public:
+    HRESULT STDMETHODCALLTYPE QueryInterface( REFIID iid, void **out ) override
+    {
+        if ( !out ) return E_POINTER;
+        if ( IsEqualIID( iid, IID_IUnknown ) || IsEqualIID( iid, IID_IXNetworkingImpl2 )
+             || IsEqualIID( iid, IID_IXNetworkingImpl ) )
+        {
+            *out = static_cast<IXNetworkingImpl2 *>( this );
+            return S_OK;
+        }
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return 1; }
+    ULONG STDMETHODCALLTYPE Release() override { return 1; }
+
+    HRESULT STDMETHODCALLTYPE XNetworkingQueryPreferredLocalUdpMultiplayerPort( UINT16 *port ) override
+    {
+        if ( port ) *port = 3074;
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE XNetworkingQueryPreferredLocalUdpMultiplayerPortAsync( XAsyncBlock *async ) override
+    {
+        /* Answering S_OK without ever completing the block leaves a caller waiting for a
+         * completion that never comes; E_NOTIMPL sends it down its synchronous path. */
+        if ( async && async->callback )
+            async->callback( async );
+        return E_NOTIMPL;
+    }
+    HRESULT STDMETHODCALLTYPE XNetworkingQueryPreferredLocalUdpMultiplayerPortAsyncResult(
+        XAsyncBlock *async, UINT16 *port ) override
+    { (void)async; if ( port ) *port = 3074; return S_OK; }
+    HRESULT STDMETHODCALLTYPE XNetworkingRegisterPreferredLocalUdpMultiplayerPortChanged(
+        XTaskQueueHandle queue, void *context, XNetworkingPreferredLocalUdpMultiplayerPortChangedCallback *callback,
+        XTaskQueueRegistrationToken *token ) override
+    { (void)queue; (void)context; (void)callback; if ( token ) token->token = 1; return S_OK; }
+    HRESULT STDMETHODCALLTYPE XNetworkingQuerySecurityInformationForUrlAsync( const char *url,
+                                                                             XAsyncBlock *async ) override
+    { (void)url; (void)async; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE XNetworkingQuerySecurityInformationForUrlAsyncResultSize(
+        XAsyncBlock *async, SIZE_T *size ) override
+    { (void)async; if ( size ) *size = 0; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE XNetworkingQuerySecurityInformationForUrlAsyncResult(
+        XAsyncBlock *async, SIZE_T size, SIZE_T *used, UINT8 *buffer,
+        XNetworkingSecurityInformation **information ) override
+    { (void)async; (void)size; (void)buffer; if ( used ) *used = 0;
+      if ( information ) *information = NULL; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE XNetworkingQuerySecurityInformationForUrlUtf16Async( const WCHAR *url,
+                                                                                   XAsyncBlock *async ) override
+    { (void)url; (void)async; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE XNetworkingQuerySecurityInformationForUrlUtf16AsyncResultSize(
+        XAsyncBlock *async, SIZE_T *size ) override
+    { (void)async; if ( size ) *size = 0; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE XNetworkingQuerySecurityInformationForUrlUtf16AsyncResult(
+        XAsyncBlock *async, SIZE_T size, SIZE_T *used, UINT8 *buffer,
+        XNetworkingSecurityInformation **information ) override
+    { (void)async; (void)size; (void)buffer; if ( used ) *used = 0;
+      if ( information ) *information = NULL; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE XNetworkingVerifyServerCertificate(
+        void *request, const XNetworkingSecurityInformation *information ) override
+    { (void)request; (void)information; return S_OK; }
+    HRESULT STDMETHODCALLTYPE XNetworkingGetConnectivityHint(
+        XNetworkingConnectivityHint *hint ) override
+    {
+        if ( hint ) memset( hint, 0, sizeof( *hint ) );
+        return S_OK;
+    }
+    /* The image registers for connectivity-hint changes and then waits on an event until the
+     * callback arrives: measured, that wait is the whole startup barrier. The callback is
+     * therefore delivered once, shortly after registration, with the hint a wired console
+     * would report. */
+
+    static DWORD WINAPI deliver( LPVOID parameter )
+    {
+        ConnectivityDelivery copy = *(ConnectivityDelivery *)parameter;
+        XNetworkingConnectivityHint hint;
+        Sleep( 500 );
+        memset( &hint, 0, sizeof( hint ) );
+        hint.connectivityLevel = XNetworkingConnectivityLevelHint::InternetAccess;
+        hint.connectivityCost = XNetworkingConnectivityCostHint::Unrestricted;
+        hint.ianaInterfaceType = 6;   /* ethernet */
+        hint.networkInitialized = TRUE;
+        hint.connectivityLevel = XNetworkingConnectivityLevelHint::InternetAccess;
+        if ( copy.callback )
+        {
+            TRACE( "delivering the connectivity hint to %p.\n", copy.callback );
+            copy.callback( copy.context, &hint );
+        }
+        return 0;
+    }
+
+    HRESULT STDMETHODCALLTYPE XNetworkingRegisterConnectivityHintChanged(
+        XTaskQueueHandle queue, void *context, XNetworkingConnectivityHintChangedCallback *callback,
+        XTaskQueueRegistrationToken *token ) override
+    {
+        (void)queue;
+        connectivity_delivery.context = context;
+        connectivity_delivery.callback = callback;
+        if ( token ) token->token = 1;
+        CloseHandle( CreateThread( NULL, 0, deliver, &connectivity_delivery, 0, NULL ) );
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE XNetworkingQueryConfigurationSetting(
+        XNetworkingConfigurationSetting setting, UINT64 *value ) override
+    { (void)setting; if ( value ) *value = 0; return S_OK; }
+    HRESULT STDMETHODCALLTYPE XNetworkingSetConfigurationSetting(
+        XNetworkingConfigurationSetting setting, UINT64 value ) override
+    { (void)setting; (void)value; return S_OK; }
+    BOOLEAN STDMETHODCALLTYPE XNetworkingUnregisterPreferredLocalUdpMultiplayerPortChanged(
+        XTaskQueueRegistrationToken token, BOOLEAN wait ) override
+    { (void)token; (void)wait; return TRUE; }
+    BOOLEAN STDMETHODCALLTYPE XNetworkingUnregisterConnectivityHintChanged(
+        XTaskQueueRegistrationToken token, BOOLEAN wait ) override
+    { (void)token; (void)wait; return TRUE; }
+    HRESULT STDMETHODCALLTYPE XNetworkingQueryStatistics( XNetworkingStatisticsType type,
+                                                          XNetworkingStatisticsBuffer *buffer ) override
+    { (void)type; if ( buffer ) memset( buffer, 0, sizeof( *buffer ) ); return S_OK; }
+};
