+/* A class this runtime does not implement yet gets an object with numbered slots instead of
+ * REGDB_E_CLASSNOTREG: the image then names the methods it expects, in order, by calling
+ * them. That is how the interface order is recovered (see the note in QueryApiImpl). */
+#define PROBE_SLOT(n) \
+    static long long WINAPI probe_##n( void *self, unsigned long long a, unsigned long long b, \
+                                       unsigned long long c ) \
+    { \
+        TRACE( "probe slot %d caller=%p args=%llx,%llx,%llx\n", n, \
+               __builtin_return_address( 0 ), a, b, c ); \
+        return 0; \
+    }
+PROBE_SLOT(0) PROBE_SLOT(1) PROBE_SLOT(2) PROBE_SLOT(3) PROBE_SLOT(4) PROBE_SLOT(5)
+PROBE_SLOT(6) PROBE_SLOT(7) PROBE_SLOT(8) PROBE_SLOT(9) PROBE_SLOT(10) PROBE_SLOT(11)
+PROBE_SLOT(12) PROBE_SLOT(13) PROBE_SLOT(14) PROBE_SLOT(15) PROBE_SLOT(16) PROBE_SLOT(17)
+PROBE_SLOT(18) PROBE_SLOT(19) PROBE_SLOT(20) PROBE_SLOT(21) PROBE_SLOT(22) PROBE_SLOT(23)
+
+static void *probe_vtable[512];
+
+static void *probe_object( void )
+{
+    unsigned i;
+    if ( !probe_vtable[0] )
+    {
+        for ( i = 0; i < sizeof(probe_vtable) / sizeof(probe_vtable[0]); i++ )
+            probe_vtable[i] = ( void * )probe_0;
+#define PROBE_SET( n ) probe_vtable[n] = ( void * )probe_##n
+        PROBE_SET( 0 ); PROBE_SET( 1 ); PROBE_SET( 2 ); PROBE_SET( 3 ); PROBE_SET( 4 );
+        PROBE_SET( 5 ); PROBE_SET( 6 ); PROBE_SET( 7 ); PROBE_SET( 8 ); PROBE_SET( 9 );
+        PROBE_SET( 10 ); PROBE_SET( 11 ); PROBE_SET( 12 ); PROBE_SET( 13 ); PROBE_SET( 14 );
+        PROBE_SET( 15 ); PROBE_SET( 16 ); PROBE_SET( 17 ); PROBE_SET( 18 ); PROBE_SET( 19 );
+        PROBE_SET( 20 ); PROBE_SET( 21 ); PROBE_SET( 22 ); PROBE_SET( 23 );
+#undef PROBE_SET
+    }
+    return probe_vtable;
+}
